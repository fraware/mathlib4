+/-- Reduce `Precomp.map` definitionally when both indices expose `Fin` constructors. -/
+dsimproc reduceMap (Precomp.map _ _ _ _ _) := fun e => do
+  let_expr Precomp.map _C _inst _n _F _X _f i j _hij := e | return .continue
+  let i' ← Meta.withTransparency .implicit <|
+    Meta.whnfHeadPred i fun e => return !e.isAppOf ``Fin.mk
+  let j' ← Meta.withTransparency .implicit <|
+    Meta.whnfHeadPred j fun e => return !e.isAppOf ``Fin.mk
+  unless i'.isAppOfArity ``Fin.mk 3 && j'.isAppOfArity ``Fin.mk 3 do
+    return .continue
+  let result ← Meta.withTransparency .implicit <|
+    Meta.whnfHeadPred e fun e => return e.isAppOf ``Precomp.map
+  if result == e then
+    return .continue
+  else
+    return .visit result
